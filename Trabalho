LINGUAGEM C

1. Calculadora de vários números
#include <stdio.h>

int main() {
    int n, i;
    float num, soma = 0, media, maior, menor;

    printf("Quantos números você deseja digitar? ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Digite o %dº número: ", i + 1);
        scanf("%f", &num);

        soma += num;
        if (i == 0) {
            maior = menor = num;
        } else {
            if (num > maior) maior = num;
            if (num < menor) menor = num;
        }
    }

    media = soma / n;

    printf("Soma total: %.2f\n", soma);
    printf("Média: %.2f\n", media);
    printf("Maior número: %.2f\n", maior);
    printf("Menor número: %.2f\n", menor);

    return 0;
}
2. Sistema de votação
#include <stdio.h>

int main() {
    int votos[3] = {0, 0, 0};
    int total_votantes, voto, i;

    printf("Quantas pessoas vão votar? ");
    scanf("%d", &total_votantes);

    for (i = 0; i < total_votantes; i++) {
        do {
            printf("Voto da pessoa %d (1, 2 ou 3): ", i + 1);
            scanf("%d", &voto);
            if (voto >= 1 && voto <= 3) {
                votos[voto - 1]++;
                break;
            } else {
                printf("Voto inválido! Digite 1, 2 ou 3.\n");
            }
        } while (1);
    }

    printf("Votos do candidato 1: %d\n", votos[0]);
    printf("Votos do candidato 2: %d\n", votos[1]);
    printf("Votos do candidato 3: %d\n", votos[2]);

    int max = votos[0], vencedor = 1;
    for (i = 1; i < 3; i++) {
        if (votos[i] > max) {
            max = votos[i];
            vencedor = i + 1;
        }
    }
    printf("O vencedor é o candidato %d com %d votos.\n", vencedor, max);

    return 0;
}
