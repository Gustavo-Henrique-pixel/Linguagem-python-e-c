#include <stdio.h>

int main() {
    float preco, total_valor = 0, preco_medio;
    int quantidade, total_itens = 0, produtos = 0;

    while (1) {
        printf("Digite o preço do produto (0 para encerrar): ");
        scanf("%f", &preco);
        if (preco == 0) break;

        printf("Digite a quantidade: ");
        scanf("%d", &quantidade);

        total_valor += preco * quantidade;
        total_itens += quantidade;
        produtos++;
    }

    if (produtos > 0)
        preco_medio = total_valor / produtos;
    else
