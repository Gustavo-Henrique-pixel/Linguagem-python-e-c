4. Controle de notas da turma
#include <stdio.h>

int main() {
    int num_alunos, i, aprovados = 0, recuperacao = 0, reprovados = 0;
    float nota, soma = 0, media;

    printf("Quantos alunos existem na turma? ");
    scanf("%d", &num_alunos);

    for (i = 0; i < num_alunos; i++) {
        printf("Digite a nota do aluno %d: ", i + 1);
        scanf("%f", &nota);
        soma += nota;

        if (nota >= 7) aprovados++;
        else if (nota >= 5) recuperacao++;
        else reprovados++;
    }

    media = soma / num_alunos;

    printf("Média da turma: %.2f\n", media);
    printf("Aprovados: %d\n", aprovados);
    printf("Recuperação: %d\n", recuperacao);
    printf("Reprovados: %d\n", reprovados);

    return 0;
}
